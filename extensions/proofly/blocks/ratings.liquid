{%- comment -%}
  Proofly — product-card ratings (app embed, all pages).
  Hydrates every `[data-pf-rating][data-product-id]` hook with that product's own rating and count using one batched
  request per page. Themes that render Shopify's standard `reviews.rating` / `reviews.rating_count` fields show ratings
  natively without this embed.
{%- endcomment -%}
{% schema %}
{
  "name": "Product card stars",
  "target": "body",
  "javascript": "proofly-ratings.js",
  "stylesheet": "proofly.css",
  "settings": []
}
{% endschema %}
