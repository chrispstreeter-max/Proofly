# Copy to .env for local development. Never commit real values.
# Application role (NOT a superuser, NOBYPASSRLS) — row-level security applies to it
DATABASE_URL="postgresql://proofly_app@localhost:54330/proofly_dev"
# Schema owner — used only by Prisma Migrate
DIRECT_DATABASE_URL="postgresql://proofly@localhost:54330/proofly_dev"
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:3000
SCOPES=read_products,write_products
# App handle in the Partner Dashboard (Shopify App Pricing hosted plan page: /charges/<handle>/pricing_plans)
SHOPIFY_APP_HANDLE=
# Fictional development store used by the local dev proxy (/apps/proofly/*)
DEV_SHOP_DOMAIN=proofly-dev.myshopify.com
# Media: local (dev) or s3 (any S3-compatible store, e.g. Cloudflare R2)
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./storage
MEDIA_PUBLIC_URL=http://localhost:3000/media
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=
S3_BUCKET_PUBLIC=
STOREFRONT_ORIGINS=http://localhost:3000
# Random 32+ characters, used to hash rate-limit keys
IP_HASH_SALT=
# 32 random bytes, base64 (openssl rand -base64 32) — encrypts Shopify access/refresh tokens at rest
TOKEN_ENCRYPTION_KEY=
# Optional: path (outside this repo) to a private hashed denylist for scripts/scan-merchant-data.ts
PROOFLY_PRIVATE_DENYLIST=
