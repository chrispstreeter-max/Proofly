generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: the application role (proofly_app) — not a superuser, NOBYPASSRLS, so row-level security applies.
// DIRECT_DATABASE_URL: the schema owner, used only by Prisma Migrate.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────────────────────────
// Tenant isolation
//  * Every merchant-owned table has shop_id (NOT NULL, FK → shops).
//  * Relations between merchant records are COMPOSITE foreign keys (shop_id, id), so the database
//    rejects a row that points at another shop's record.
//  * Postgres row-level security on every merchant-owned table (migration "tenant_rls") restricts rows to
//    current_setting('app.shop_id'); application code also filters by shopId (app/lib/tenant.server.ts).
// ─────────────────────────────────────────────────────────────────────────────────────────────────

// Shopify OAuth session storage (template shape). Access/refresh tokens are stored encrypted (app/lib/session-storage.server.ts).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

/// One row per Shopify store that has installed Proofly. Identity comes only from authenticated Shopify context.
model Shop {
  id              String    @id @default(uuid()) @db.Uuid
  shopifyShopId   BigInt?   @unique @map("shopify_shop_id")
  shopDomain      String    @unique @map("shop_domain") // e.g. example.myshopify.com (from the authenticated session)
  shopName        String?   @map("shop_name")
  /// Storefront hosts of this shop (primary domain etc.), from the Admin API at install — used for the Origin check.
  storefrontHosts String[]  @default([]) @map("storefront_hosts")
  installedAt     DateTime  @default(now()) @map("installed_at")
  uninstalledAt   DateTime? @map("uninstalled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  settings          ShopSettings?
  billing           BillingState?
  subscriptions     Subscription[]
  products          Product[]
  reviews           Review[]
  reviewImages      ReviewImage[]
  reviewReplies     ReviewReply[]
  reviewRequests    ReviewRequest[]
  moderationActions ModerationAction[]
  importJobs        ImportJob[]
  auditLogs         AuditLog[]

  @@map("shops")
}

model ShopSettings {
  shopId                  String    @id @map("shop_id") @db.Uuid
  widgetEnabled           Boolean   @default(true) @map("widget_enabled")
  reviewSubmissionEnabled Boolean   @default(true) @map("review_submission_enabled")
  photoReviewsEnabled     Boolean   @default(true) @map("photo_reviews_enabled")
  moderationEnabled       Boolean   @default(true) @map("moderation_enabled")
  themeSettings           Json      @default("{}") @map("theme_settings")
  displaySettings         Json      @default("{}") @map("display_settings")
  /// Set when the merchant finishes the first-run setup checklist. Kept across uninstall/reinstall.
  onboardingCompletedAt   DateTime? @map("onboarding_completed_at")
  /// This merchant's Shopify app proxy path (prefix + subpath, e.g. /apps/proofly). Set explicitly per shop at install
  /// (app/lib/proxy-path.server.ts); storefront requests signed with any other path_prefix are rejected.
  proxyPath               String    @map("proxy_path")
  /// proxyPath value last written to the app-data metafield the theme extension reads (null = never written).
  proxyPathPublished      String?   @map("proxy_path_published")
  /// Catalogue sync (app/lib/products.server.ts): never | running | completed | failed. Cursor allows resuming.
  catalogSyncStatus       String    @default("never") @map("catalog_sync_status")
  catalogSyncCursor       String?   @map("catalog_sync_cursor")
  catalogSyncStartedAt    DateTime? @map("catalog_sync_started_at")
  catalogSyncFinishedAt   DateTime? @map("catalog_sync_finished_at")
  catalogSyncCount        Int       @default(0) @map("catalog_sync_count")
  catalogSyncError        String?   @map("catalog_sync_error")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_settings")
}

/// Stable internal plan identifiers (app/lib/plans.ts). Never prices, never Shopify subscription ids.
enum PlanKey {
  FREE
  STARTER
  GROWTH
  PRO
  SCALE
}

/// Proofly's entitlement state for one shop — a cache of what Shopify App Pricing says, never the financial record.
/// `plan` changes ONLY when billing.server reconciles a confirmed Shopify state. An API failure leaves it untouched
/// (verification = unverified) — never an implicit upgrade or downgrade.
model BillingState {
  shopId                String    @id @map("shop_id") @db.Uuid
  plan                  PlanKey   @default(FREE)
  /// monthly | annual (null on Free)
  interval              String?
  /// confirmed | unverified
  verification          String    @default("unverified")
  /// Latest Shopify subscription status relevant to the shop: none | pending | active | frozen | cancelled | declined | expired
  shopifyStatus         String    @default("none") @map("shopify_status")
  shopifySubscriptionId String?   @map("shopify_subscription_id")
  planHandle            String?   @map("plan_handle")
  test                  Boolean   @default(false)
  trialDays             Int       @default(0) @map("trial_days")
  currentPeriodEnd      DateTime? @map("current_period_end")
  verifiedAt            DateTime? @map("verified_at")
  checkError            String?   @map("check_error")
  planChangedAt         DateTime? @map("plan_changed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("billing_state")
}

/// Cache of the shop's Shopify app subscriptions as last read from the Admin API (history for support/audit).
model Subscription {
  id                    String    @id @default(uuid()) @db.Uuid
  shopId                String    @map("shop_id") @db.Uuid
  shopifySubscriptionId String    @map("shopify_subscription_id")
  /// Proofly plan the subscription maps to (null = unknown plan handle)
  plan                  PlanKey?
  planHandle            String?   @map("plan_handle")
  name                  String
  /// Shopify AppSubscriptionStatus, lower-case
  status                String
  interval              String?
  priceAmount           Decimal?  @map("price_amount") @db.Decimal(10, 2)
  currencyCode          String?   @map("currency_code")
  test                  Boolean   @default(false)
  trialDays             Int       @default(0) @map("trial_days")
  currentPeriodEnd      DateTime? @map("current_period_end")
  shopifyCreatedAt      DateTime  @map("shopify_created_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, shopifySubscriptionId])
  @@index([shopId])
  @@map("subscriptions")
}

enum ReviewStatus {
  pending
  published
  rejected
  hidden
}

/// Why a review is held back from the storefront (null = not held). plan_limit = over the plan's published allowance.
enum HoldReason {
  moderation
  plan_limit
}

/// Who owns a product's Shopify rating metafields (reviews.rating / reviews.rating_count).
/// unmanaged: Proofly never writes them (they may belong to another review app). proofly_managed: Proofly keeps them
/// equal to its canonical aggregate. A product becomes proofly_managed when it first has a public Proofly review.
enum RatingOwnership {
  unmanaged
  proofly_managed
}

/// Public (optimised) media state. Only `published` media is ever served on the storefront.
enum MediaStatus {
  published
  storage_limited
  processing
  failed
}

model Product {
  id               String          @id @default(uuid()) @db.Uuid
  shopId           String          @map("shop_id") @db.Uuid
  shopifyProductId BigInt          @map("shopify_product_id")
  shopifyVariantId BigInt?         @map("shopify_variant_id")
  handle           String
  title            String
  image            String?
  /// Shopify ProductStatus, lower-case: active | draft | archived | unlisted. Deleted products keep their last status.
  status           String?
  /// Shopify's updatedAt of the version stored here — older webhook deliveries never overwrite newer data.
  shopifyUpdatedAt DateTime?       @map("shopify_updated_at")
  /// Last time a catalogue sync or webhook saw this product in Shopify (full-sync sweep marks the rest deleted).
  lastSeenAt       DateTime?       @map("last_seen_at")
  /// Deleted in Shopify. Reviews are kept; the row is never re-attached to a new product (identity = shopifyProductId).
  deletedAt        DateTime?       @map("deleted_at")
  // Canonical aggregate over PUBLIC reviews (published, not held). Written only by app/lib/aggregates.server.ts.
  reviewCount      Int             @default(0) @map("review_count")
  averageRating    Decimal         @default(0) @map("average_rating") @db.Decimal(3, 2)
  rating1          Int             @default(0) @map("rating_1")
  rating2          Int             @default(0) @map("rating_2")
  rating3          Int             @default(0) @map("rating_3")
  rating4          Int             @default(0) @map("rating_4")
  rating5          Int             @default(0) @map("rating_5")
  /// Public reviews with at least one public (published, not storage-limited) photo.
  photoReviewCount Int             @default(0) @map("photo_review_count")
  ratingOwnership  RatingOwnership @default(unmanaged) @map("rating_ownership")
  ratingManagedAt  DateTime?       @map("rating_managed_at")
  // Last values confirmed written to Shopify's rating metafields (derived cache). Differs from the aggregate = needs sync.
  syncedCount      Int?            @map("synced_count")
  syncedAverage    Decimal?        @map("synced_average") @db.Decimal(3, 2)
  ratingSyncedAt   DateTime?       @map("rating_synced_at")
  ratingSyncError  String?         @map("rating_sync_error")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  reviews Review[]

  @@unique([shopId, shopifyProductId])
  @@unique([shopId, id])
  @@index([shopId, handle])
  @@map("products")
}

model Review {
  id                String       @id @default(uuid()) @db.Uuid
  shopId            String       @map("shop_id") @db.Uuid
  productId         String       @map("product_id") @db.Uuid
  source            String // import source key (e.g. "csv") | storefront | request
  sourceReviewId    String       @map("source_review_id")
  rating            Int
  title             String       @default("")
  body              String
  reviewerName      String       @map("reviewer_name")
  reviewDate        DateTime     @map("review_date")
  status            ReviewStatus @default(pending)
  holdReason        HoldReason?  @map("hold_reason") // storefront shows only status = published AND hold_reason IS NULL
  verifiedPurchase  Boolean      @default(false) @map("verified_purchase")
  imported          Boolean      @default(false)
  flags             String[]     @default([])
  // Private: never serialised to the storefront.
  shopifyCustomerId BigInt?      @map("shopify_customer_id")
  shopifyOrderId    BigInt?      @map("shopify_order_id")
  submitterIpHash   String?      @map("submitter_ip_hash")
  /// Import that created this review (metadata; tenant-scoped by RLS). Re-imports never change it except to adopt
  /// rows of an import that never finished.
  importJobId       String?      @map("import_job_id") @db.Uuid
  /// The product identifiers exactly as the source gave them (audit), e.g. {"id":"…","handle":"…","sku":"…"}
  sourceProductRef  String?      @map("source_product_ref")
  /// sha256 of normalised reviewer + body: duplicate / cross-product-repeat flagging only (never publication)
  contentHash       String?      @map("content_hash")
  sourceDateRaw     String?      @map("source_date_raw")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  shop              Shop               @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [shopId, productId], references: [shopId, id], onDelete: Cascade)
  images            ReviewImage[]
  reply             ReviewReply?
  request           ReviewRequest?
  moderationActions ModerationAction[]

  @@unique([shopId, source, sourceReviewId])
  @@unique([shopId, id])
  @@index([shopId, productId, status, reviewDate(sort: Desc)])
  @@index([shopId, importJobId])
  @@index([shopId, contentHash])
  @@index([shopId, status, reviewDate(sort: Desc)])
  @@map("reviews")
}

model ReviewImage {
  id               String      @id @default(uuid()) @db.Uuid
  shopId           String      @map("shop_id") @db.Uuid
  reviewId         String      @map("review_id") @db.Uuid
  originalFilename String      @map("original_filename")
  storageKey       String      @map("storage_key") // private original (s/<shop>/originals/…)
  thumbKey         String      @map("thumb_key") // public WebP 320px (s/<shop>/r/…)
  largeKey         String      @map("large_key") // public WebP 1600px
  originalUrl      String?     @map("original_url")
  contentType      String      @map("content_type")
  fileSize         Int         @map("file_size")
  sha256           String
  width            Int?
  height           Int?
  position         Int         @default(0)
  mediaStatus      MediaStatus @default(published) @map("media_status")
  /// Bytes of the two optimised public derivatives (320 + 1600) — what counts toward the public media allowance.
  publicBytes      Int         @default(0) @map("public_bytes")
  /// Opaque public asset id (128 random bits, hex). The ONLY identifier in public media URLs.
  publicId         String      @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("public_id")
  createdAt        DateTime    @default(now()) @map("created_at")

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [shopId, reviewId], references: [shopId, id], onDelete: Cascade)

  @@unique([reviewId, sha256])
  @@index([shopId, reviewId])
  @@map("review_images")
}

model ReviewReply {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  reviewId  String   @unique @map("review_id") @db.Uuid
  reply     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [shopId, reviewId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, reviewId])
  @@map("review_replies")
}

/// V1.1 feature (review requests) — table retained and tenant-scoped; not part of the V1 product scope.
model ReviewRequest {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @map("shop_id") @db.Uuid
  shopifyCustomerId BigInt?   @map("shopify_customer_id")
  shopifyOrderId    BigInt    @map("shopify_order_id")
  shopifyProductId  BigInt    @map("shopify_product_id")
  // SHA-256 of the emailed token, set when the link is issued (raw token is never stored).
  tokenHash         String?   @map("token_hash")
  sentAt            DateTime? @map("sent_at")
  completedAt       DateTime? @map("completed_at")
  expiresAt         DateTime? @map("expires_at")
  reviewId          String?   @unique @map("review_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  shop   Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  review Review? @relation(fields: [shopId, reviewId], references: [shopId, id])

  @@unique([shopId, shopifyOrderId, shopifyProductId])
  @@unique([shopId, reviewId])
  @@index([shopId, tokenHash])
  @@map("review_requests")
}

/// Moderation history (one row per status change), merchant-private.
model ModerationAction {
  id         String       @id @default(uuid()) @db.Uuid
  shopId     String       @map("shop_id") @db.Uuid
  reviewId   String       @map("review_id") @db.Uuid
  action     String
  fromStatus ReviewStatus @map("from_status")
  toStatus   ReviewStatus @map("to_status")
  actor      String
  createdAt  DateTime     @default(now()) @map("created_at")

  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [shopId, reviewId], references: [shopId, id], onDelete: Cascade)

  @@index([shopId, reviewId, createdAt(sort: Desc)])
  @@map("moderation_actions")
}

/// Import job records (the import pipeline itself arrives in a later checkpoint).
/// One import run (app/lib/import.server.ts). Lifecycle: queued → running → completed | completed_with_warnings | failed
/// | cancelled. Resumable: `cursor` = next source record to process, committed together with each batch.
model ImportJob {
  id                String    @id @default(uuid()) @db.Uuid
  shopId            String    @map("shop_id") @db.Uuid
  source            String
  status            String    @default("queued")
  /// publishMode, column mapping — never a shop or tenant id
  options           Json      @default("{}")
  fileKey           String?   @map("file_key")
  imagesKey         String?   @map("images_key")
  /// validation + matching result computed before any review is written
  analysis          Json      @default("{}")
  counts            Json      @default("{}")
  report            Json      @default("{}")
  totalRows         Int       @default(0) @map("total_rows")
  cursor            Int       @default(0)
  actor             String?
  error             String?
  startedAt         DateTime? @map("started_at")
  heartbeatAt       DateTime? @map("heartbeat_at")
  cancelRequestedAt DateTime? @map("cancel_requested_at")
  finalizedAt       DateTime? @map("finalized_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  finishedAt        DateTime? @map("finished_at")

  shop    Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)
  matches ImportProductMatch[]

  @@unique([shopId, id])
  @@index([shopId, createdAt(sort: Desc)])
  @@map("import_jobs")
}

/// How one source product reference in an import resolved: matched (by id / handle / sku), unmatched or ambiguous.
/// Title is never an automatic key: exact-title products appear only in `candidates` as suggestions. Manual
/// confirmation (checkpoint 8) will set product_id + method = manual.
model ImportProductMatch {
  id               String   @id @default(uuid()) @db.Uuid
  shopId           String   @map("shop_id") @db.Uuid
  importJobId      String   @map("import_job_id") @db.Uuid
  sourceProductRef String   @map("source_product_ref")
  /// matched | unmatched | ambiguous
  status           String
  /// id | handle | sku | manual (null unless matched)
  method           String?
  /// This shop's products.id when matched. Reviews written with it are protected by their composite (shop_id, product_id) FK.
  productId        String?  @map("product_id") @db.Uuid
  reason           String?
  /// suggestions for the merchant: [{ productId, title, handle, via }] — never used automatically
  candidates       Json     @default("[]")
  rows             Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")

  importJob ImportJob @relation(fields: [shopId, importJobId], references: [shopId, id], onDelete: Cascade)

  @@unique([shopId, importJobId, sourceProductRef])
  @@map("import_product_matches")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  actor     String
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, entity, entityId])
  @@map("audit_log")
}
